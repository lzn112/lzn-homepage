---
import Layout from '../layouts/Layout.astro';
import home from '../data/home.json';

const pageTitle = home.pageTitle;
---

<Layout pageTitle={pageTitle}>
  <div class="gif">
    <img
      src={home.heroImage}
      role="presentation"
      width="300"
      height="259"
      decoding="async"
    />
  </div>

  <h1>{home.name}</h1>

  <span class="badge">{home.role}</span>

  <h2>{home.aboutTitle}</h2>

  {home.about.map((paragraph) => (
    <p>{paragraph}</p>
  ))}

<nav class="quick-links" aria-label="首页快捷入口">
  {home.quickLinks.map((link) => {
    const external = link.url.startsWith("http");

    return (
      <a
        class="quick-link"
        href={link.url}
        target={external ? "_blank" : undefined}
        rel={external ? "noopener noreferrer" : undefined}
      >
        <span>{link.label}</span>
        <span class="quick-link__arrow" aria-hidden="true">
          {external ? "↗" : "→"}
        </span>
      </a>
    );
  })}
</nav>
  
<h2>{home.skillsTitle}</h2>

  <div class="skills center">
    {home.skills.map((skill) => (
      <img
        class="skills__img"
        width="46"
        height="46"
        alt={skill.name}
        src={skill.icon}
      />
    ))}
  </div>

  <h2>{home.interestsTitle}</h2>

  <p>{home.interests}</p>
</Layout>

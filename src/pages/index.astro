---
import Layout from '../layouts/Layout.astro';
import home from '../data/home.json';

const pageTitle = home.pageTitle;
---

<Layout pageTitle={pageTitle}>
  <div class="gif">
    <img
      src={home.heroImage}
      role="presentation"
      width="300"
      height="259"
      decoding="async"
    />
  </div>

  <h1>{home.name}</h1>

  <span class="badge">{home.role}</span>

  <h2>{home.aboutTitle}</h2>

  {home.about.map((paragraph) => (
    <p>{paragraph}</p>
  ))}

  <div class="center">
    <a href={home.projectsButtonUrl}>
      <button class="btn">{home.projectsButtonText}</button>
    </a>
  </div>

  <h2>{home.skillsTitle}</h2>

  <div class="skills center">
    {home.skills.map((skill) => (
      <img
        class="skills__img"
        width="46"
        height="46"
        alt={skill.name}
        src={skill.icon}
      />
    ))}
  </div>

  <h2>{home.interestsTitle}</h2>

  <p>{home.interests}</p>
</Layout>

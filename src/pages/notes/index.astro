---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const pageTitle = 'Notes | Tiancai楠';

function parseDate(value: string) {
  const parts = value.split('-').map(Number);

  // 同时兼容 MM-DD-YYYY 和 YYYY-MM-DD
  if (parts[0] > 1900) {
    return new Date(parts[0], parts[1] - 1, parts[2]);
  }

  return new Date(parts[2], parts[0] - 1, parts[1]);
}

function formatDate(value: string) {
  const date = parseDate(value);

  return new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
}

const notes = (await getCollection('posts')).sort(
  (a, b) =>
    parseDate(b.data.date).getTime() -
    parseDate(a.data.date).getTime()
);
---

<Layout pageTitle={pageTitle}>
  <main class="notes-page">
    <header class="notes-header">
      <p class="notes-kicker">LEARNING LOG</p>
      <h1>Notes</h1>
      <p class="notes-description">
        这里存放我的学习笔记、技术记录和偶尔冒出来的奇怪想法。
      </p>
    </header>

    {
      notes.length > 0 ? (
        <div class="notes-grid">
          {notes.map((note) => (
            <article class="note-card">
              <a class="note-card__link" href={`/posts/${note.id}/`}>
                <div class="note-card__image">
                  <img
                    src={note.data.image.url}
                    alt={note.data.image.alt}
                    loading="lazy"
                    width="600"
                    height="360"
                  />
                </div>

                <div class="note-card__content">
                  <time datetime={note.data.date}>
                    {formatDate(note.data.date)}
                  </time>

                  <h2>{note.data.title}</h2>

                  <div class="note-card__footer">
                    <span>{note.data.author}</span>
                    <span aria-hidden="true">阅读 →</span>
                  </div>
                </div>
              </a>
            </article>
          ))}
        </div>
      ) : (
        <div class="notes-empty">
          <span>□</span>
          <p>暂时还没有笔记。</p>
        </div>
      )
    }
  </main>
</Layout>

<style>
  .notes-page {
    padding: 1.5rem 0 4rem;
  }

  .notes-header {
    margin-bottom: 2rem;
  }

  .notes-kicker {
    margin: 0 0 0.45rem;
    color: var(--button);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.14em;
  }

  .notes-header h1 {
    margin: 0;
  }

  .notes-description {
    max-width: 34rem;
    margin-top: 0.8rem;
    color: var(--text);
    line-height: 1.8;
    opacity: 0.8;
  }

  .notes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .note-card {
    overflow: hidden;
    border: 2px solid var(--button);
    border-radius: 8px;
    background: var(--background-card);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .note-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px var(--accent-glow);
  }

  .note-card__link {
    display: block;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .note-card__image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 2px solid var(--button);
  }

  .note-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.25s ease;
  }

  .note-card:hover .note-card__image img {
    transform: scale(1.04);
  }

  .note-card__content {
    padding: 1rem;
  }

  .note-card time {
    color: var(--button);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .note-card h2 {
    margin: 0.55rem 0 1rem;
    font-family: var(--body);
    font-size: 1.1rem;
    line-height: 1.45;
  }

  .note-card__footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.82rem;
    font-weight: 700;
    opacity: 0.75;
  }

  .notes-empty {
    padding: 3rem 1rem;
    border: 2px dashed var(--button);
    border-radius: 8px;
    text-align: center;
  }

  .notes-empty span {
    color: var(--button);
    font-size: 2rem;
  }

  @media (max-width: 540px) {
    .notes-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
